# Copy this file to .env and fill in the values. Never commit .env.

# Solari browser API key: sign in at https://getsolari.com and copy the key from your dashboard.
SOLARI_API_KEY=

# Gemini API key: create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model name: pick a FREE-TIER model in Google AI Studio and paste its exact name here.
GEMINI_MODEL=
